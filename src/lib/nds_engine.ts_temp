export interface AppliedCondition {
  key: keyof NDSWeights;
  name: string;
  value: number;
}

export interface NDSResult {
  percentage: number;
  netScore: number;
  maxPossible: number;
  conditions: AppliedCondition[];
  breakdown: {
    baseLordship: number;
    dignityScore: number;
    mutualPlacement: number;
    arudhaModifiers: number;
    awasthaModifiers: number;
    praveshOffset: number;
  };
}


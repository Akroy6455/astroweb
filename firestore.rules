rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adarsh6455@gmail.com' ||
        request.auth.token.email == 'akroy6455@gmail.com'
      );
    }
    
    match /users/{userId} {
      // User can read/write their own document, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /stats/{document=**} {
      // Admins can read stats
      allow read: if isAdmin();
      // Allow any user to update stats (like chartsGenerated counter)
      allow write: if true; 
    }
  }
}
